# Keep private staff availability and requests accessible through authenticated PHP only.
# Applies to their timestamped backup files in child directories as well.
<FilesMatch "^(teacher_ng|staff_requests)\.json(?:\..*)?$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
